[Desktop Entry]
Type=Application
Name=Spreadsheet
GenericName=Spreadsheet
Comment=View and edit spreadsheets
Exec=cce-spreadsheet %f
Icon=cce-spreadsheet
Terminal=false
Categories=Office;Spreadsheet;
MimeType=application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;text/csv;text/tab-separated-values;
NoDisplay=false
